	@Value("classpath:static/data/student.json")
	private Resource studentJsonresource;
	
	private final ObjectMapper mapper;
	
	public StudentDTO getStudentData()throws IOException {
		//Read JSON file content as String
		String studentJson=new String(studentJsonresource.getInputStream().readAllBytes(), 
				                                                     StandardCharsets.UTF_8);
		log.info("Student JSON is student: {}",studentJson);
		//Convert JSOn string to DTO
		return mapper.readValue(studentJson, StudentDTO.class);
	}
